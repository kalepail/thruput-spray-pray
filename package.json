{
  "name": "thruput-spray-pray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "./scripts/deploy.sh",
    "typecheck": "cf workers types && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "test:load": "tsx scripts/test-load.ts",
    "test:latency": "tsx scripts/receipt-latency.ts",
    "test:headline": "tsx scripts/test-headline.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build",
    "test:security": "tsx scripts/test-security.ts",
    "test:lease": "tsx scripts/test-lease.ts",
    "watch:blocks": "tsx scripts/block-watch.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@thruputchain/client": "0.25.0",
    "@thruputchain/protocol": "0.19.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "cf": "1.0.0-beta.20",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  }
}
