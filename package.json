{
  "name": "thruput-spray-pray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "tsx scripts/test-live.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:load": "tsx scripts/test-load.ts",
    "profile:prepare": "tsx scripts/profile-prepare.ts",
    "profile:load": "tsx scripts/profile-load.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@thruputchain/client": "0.18.0",
    "@thruputchain/protocol": "0.15.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
